    "NSMicrophoneUsageDescription" : {
      "comment" : "Mac twin of Conduit/InfoPlist.xcstrings; keep in sync",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verwendet das Mikrofon für Sprachunterhaltungen mit Hermes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses the microphone for voice conversations with Hermes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit usa el micrófono para las conversaciones de voz con Hermes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit utilise le micro pour les conversations vocales avec Hermes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit menggunakan mikrofon untuk percakapan suara dengan Hermes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit usa il microfono per le conversazioni vocali con Hermes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは、Hermesとの音声会話にマイクを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit은 Hermes와의 음성 대화에 마이크를 사용해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit używa mikrofonu do rozmów głosowych z Hermesem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit usa o microfone para conversas por voz com o Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit использует микрофон для голосовых разговоров с Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, mikrofonu Hermes ile sesli konuşmalar için kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 使用麦克风与 Hermes 进行语音对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 會將麥克風用於與 Hermes 的語音對話。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Mac twin of Conduit/InfoPlist.xcstrings; keep in sync",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verwendet die Apple-Spracherkennung, um deine Sprache in Text umzuwandeln. Sprachunterhaltungen und Aktivierungsphrasen werden immer auf deinem Mac erkannt. Diktate ebenfalls, wenn deine Sprache das unterstützt; andernfalls kann Apple dein Diktat auf seinen Servern verarbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit uses Apple speech recognition to turn your voice into text. Voice conversations and wake phrases are always recognized on your Mac. Dictation is too when your language supports it; otherwise Apple may process your dictation on its servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit usa el reconocimiento de voz de Apple para convertir tu voz en texto. Las conversaciones de voz y las frases de activación siempre se reconocen en tu Mac. El dictado también, si tu idioma lo admite; si no, Apple puede procesar tu dictado en sus servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit utilise la reconnaissance vocale d'Apple pour transformer votre voix en texte. Les conversations vocales et les phrases d'activation sont toujours reconnues sur votre Mac. La dictée aussi lorsque votre langue le permet ; sinon, Apple peut traiter votre dictée sur ses serveurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit menggunakan pengenalan ucapan Apple untuk mengubah suara Anda menjadi teks. Percakapan suara dan frasa pemicu selalu dikenali di Mac Anda. Dikte juga, jika bahasa Anda mendukungnya; jika tidak, Apple dapat memproses dikte Anda di servernya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit usa il riconoscimento vocale di Apple per trasformare la tua voce in testo. Le conversazioni vocali e le frasi di attivazione vengono sempre riconosciute sul tuo Mac. Anche la dettatura, quando la tua lingua lo consente; altrimenti Apple può elaborare la tua dettatura sui propri server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ConduitはAppleの音声認識を使って、話した内容をテキストに変換します。音声会話とウェイクフレーズは常にMac上で認識されます。音声入力も言語が対応していればMac上で処理され、対応していない場合はAppleのサーバで処理されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit은 Apple 음성 인식을 사용해 음성을 텍스트로 변환해요. 음성 대화와 호출 문구는 항상 Mac에서 인식돼요. 받아쓰기도 언어가 지원하면 Mac에서 처리되고, 그렇지 않으면 Apple 서버에서 처리될 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit używa rozpoznawania mowy Apple, aby zamieniać Twój głos na tekst. Rozmowy głosowe i frazy aktywujące są zawsze rozpoznawane na Twoim Macu. Dyktowanie również, gdy Twój język to obsługuje; w przeciwnym razie Apple może przetwarzać Twoje dyktowanie na swoich serwerach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit usa o reconhecimento de fala da Apple para transformar sua voz em texto. Conversas por voz e frases de ativação são sempre reconhecidas no seu Mac. O ditado também, quando seu idioma permite; caso contrário, a Apple pode processar seu ditado nos servidores dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit использует распознавание речи Apple, чтобы преобразовывать ваш голос в текст. Голосовые разговоры и фразы активации всегда распознаются на вашем Mac. Диктовка тоже, если ваш язык это поддерживает; иначе Apple может обрабатывать вашу диктовку на своих серверах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, sesinizi metne dönüştürmek için Apple konuşma tanımayı kullanır. Sesli konuşmalar ve uyandırma ifadeleri her zaman Mac'inizde tanınır. Dikte de diliniz destekliyorsa Mac'inizde tanınır; aksi takdirde Apple diktenizi kendi sunucularında işleyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 使用 Apple 语音识别将你的语音转换为文字。语音对话和唤醒短语始终在你的 Mac 上识别。如果你的语言支持，听写也会在 Mac 上进行；否则 Apple 可能会在其服务器上处理你的听写内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 會使用 Apple 語音辨識將你的語音轉換為文字。語音對話和喚醒詞一律在你的 Mac 上辨識。如果你的語言支援，聽寫也會在 Mac 上進行；否則 Apple 可能會在其伺服器上處理你的聽寫內容。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Mac twin of Conduit/InfoPlist.xcstrings; keep in sync",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit verbindet sich mit deinem eigenen Hermes-Server, wenn er in deinem Heim- oder lokalen Netzwerk ist. Nichts davon geht an den Entwickler von Conduit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit connects to your own Hermes server when it is on your home or local network. Nothing goes to Conduit's developer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit se conecta a tu propio servidor de Hermes cuando está en tu red doméstica o local. Nada se envía al desarrollador de Conduit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit se connecte à votre propre serveur Hermes lorsqu'il est sur votre réseau domestique ou local. Rien n'est envoyé au développeur de Conduit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit terhubung ke server Hermes Anda sendiri saat server itu berada di jaringan rumah atau lokal Anda. Tidak ada yang dikirim ke developer Conduit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit si connette al tuo server Hermes quando è sulla tua rete domestica o locale. Nulla viene inviato allo sviluppatore di Conduit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduitは、あなた自身のHermesサーバが家庭内ネットワークまたはローカルネットワーク上にある場合、そのサーバに接続します。Conduitの開発者には何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 Hermes 서버가 가정 또는 로컬 네트워크에 있으면 Conduit이 그 서버에 연결해요. Conduit 개발자에게는 아무것도 전송되지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit łączy się z Twoim własnym serwerem Hermes, gdy jest on w Twojej sieci domowej lub lokalnej. Nic nie trafia do dewelopera Conduit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit se conecta ao seu próprio servidor Hermes quando ele está na sua rede doméstica ou local. Nada é enviado ao desenvolvedor do Conduit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit подключается к вашему собственному серверу Hermes, когда он находится в вашей домашней или локальной сети. Разработчику Conduit ничего не передаётся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, kendi Hermes sunucunuz ev veya yerel ağınızda olduğunda ona bağlanır. Conduit'in geliştiricisine hiçbir şey gitmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你自己的 Hermes 服务器位于家庭或本地网络中时，Conduit 会连接它。不会向 Conduit 的开发者发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你自己的 Hermes 伺服器位於家用或區域網路中時，Conduit 會連線到它。不會傳送任何內容給 Conduit 的開發者。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
