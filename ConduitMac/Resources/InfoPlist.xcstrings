          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit, kameranızdan çekilen bir fotoğrafı bir sohbete ekleyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 可以将你相机拍摄的照片附加到聊天中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit 可以將你相機拍攝的照片附加到聊天中。"
          }
        }
