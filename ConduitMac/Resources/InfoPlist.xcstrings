        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit은 카메라로 찍은 사진을 채팅에 첨부할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conduit może dołączyć do czatu zdjęcie z Twojego aparatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Conduit pode anexar a um chat uma foto da sua câmera."
          }
        },
        "ru" : {
          "stringUnit" : {
